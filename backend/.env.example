# Copy to .env and set values. Never commit .env.
#
# Production (NODE_ENV=production): all of JWT_SECRET, ADMIN_EMAIL, and either
# ADMIN_PASSWORD_HASH or ADMIN_PASSWORD are required.

# Strong secret, 32+ characters (required in production)
# JWT_SECRET=

# Admin login email (required in production)
# ADMIN_EMAIL=admin@example.com

# Option A: bcrypt hash of the admin password (recommended for production)
# ADMIN_PASSWORD_HASH=$2a$12$...

# Option B: plain password at boot (hash derived once; avoid in shared hosting logs)
# ADMIN_PASSWORD=

# Comma-separated allowed browser origins (defaults to Vite dev URLs if unset)
# CORS_ORIGIN=http://localhost:5173,https://yourdomain.com

# Server port (default 5000)
# PORT=5000

# Set to 1 when the API sits behind a reverse proxy (for rate-limit IP accuracy)
# TRUST_PROXY=1
